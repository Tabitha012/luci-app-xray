msgstr "此目标必须通过出站服务器转发。"

msgid "Force Forward (UDP)"
msgstr "强制转发 (UDP)"

# ========== HTTPS Server 页面 ==========
msgid "Enable Xray HTTPS Server"
msgstr "启用 Xray HTTPS 服务器"

msgid "This will start a HTTPS server which serves both as an inbound for Xray and a reverse proxy web server."
msgstr "这将启动一个 HTTPS 服务器，同时作为 Xray 的入站和反向代理 Web 服务器。"

msgid "Xray HTTPS Server Port"
msgstr "Xray HTTPS 服务器端口"

msgid "This port needs to be set"
msgstr "此端口需要在防火墙设置中"

msgid "manually in firewall settings."
msgstr "手动设置。"

msgid "Only protocols which support fallback are available. Note that REALITY does not support fallback right now."
msgstr "仅支持支持回退的协议。注意 REALITY 目前不支持回退。"

msgid "Decrypt Method"
msgstr "解密方式"

msgid "Stream Security"
msgstr "流安全"

msgid "Flow"
msgstr "流控"

msgid "Certificate File"
msgstr "证书文件"

msgid "Private Key File"
msgstr "私钥文件"

msgid "选择文件."
msgstr "选择文件。"

msgid "Fill user_id for vmess / VLESS, or password for shadowsocks / trojan (also supports Xray UUID Mapping)"
msgstr "填写 vmess/VLESS 的 user_id，或 shadowsocks/trojan 的密码（也支持 Xray UUID 映射）"

msgid "Default Fallback HTTP Server"
msgstr "默认回退 HTTP 服务器"

msgid "Only HTTP/1.1 supported here. For HTTP/2 upstream, use Fallback Servers below"
msgstr "此处仅支持 HTTP/1.1。如需 HTTP/2 上游，请使用下方的回退服务器"

msgid "Fallback Servers"
msgstr "回退服务器"

msgid "Specify upstream servers here."
msgstr "在此指定上游服务器。"

