# ========== 常规设置 - 出站路由 ==========
msgid "GeoIPDirectCodeList(IPv4)"
msgstr "GeoIP 直连列表 (IPv4)"

msgid "GeoIPDirectCodeList(IPv6)"
msgstr "GeoIP 直连列表 (IPv6)"

msgid "Hosts in these GeoIP sets will not be forwarded through Xray.Remove all items to forward all non-private hosts."
msgstr "这些 GeoIP 集合中的主机不会通过 Xray 转发。删除所有项以转发所有非私有主机。"

msgid "Bypassed IP"
msgstr "绕过 IP"

msgid "Requests to these IPs won't be forwarded through Xray."
msgstr "发往这些 IP 的请求不会通过 Xray 转发。"

msgid "Forwarded IP"
msgstr "转发 IP"

msgid "Requests to these IPs will always be handled by Xray(but still might be bypassed by Xray itself,like private addresses)."
msgstr "发往这些 IP 的请求将始终由 Xray 处理（但仍可能被 Xray 自身绕过，如私有地址）。"

msgid "Default Ports Policy"
msgstr "默认端口策略"

msgid "Forwarded"
msgstr "转发"

msgid "Bypassed TCP Ports"
msgstr "绕过的 TCP 端口"

msgid "Requests to these TCP Ports won't be forwarded through Xray."
msgstr "发往这些 TCP 端口的请求不会通过 Xray 转发。"

msgid "Bypassed UDP Ports"
msgstr "绕过的 UDP 端口"

msgid "Requests to these UDP Ports won't be forwarded through Xray."
msgstr "发往这些 UDP 端口的请求不会通过 Xray 转发。"

# ========== 添加规则对话框 ==========
msgid "Source Address"
msgstr "源地址"

msgid "Fill an IP address or a rule like"
msgstr "填写 IP 地址或类似规则"

msgid "Source Port"
msgstr "源端口"

msgid "Leave empty to forward all ports."
msgstr "留空以转发所有端口。"

msgid "Destination Address"
msgstr "目标地址"

msgid "Leave empty to keep original address unchanged."
msgstr "留空以保持原始地址不变。"

msgid "Destination Port"
msgstr "目标端口"

msgid "Fill to keep original port unchanged."
msgstr "填写以保持原始端口不变。"

msgid "Domain names to associate"
msgstr "关联的域名"

msgid "Resolve these domains to Source Address above. Only possible when an IP address is used."
msgstr "将这些域名解析到上面的源地址。仅当使用 IP 地址时可用。"

msgid "Exempt rebind protection"
msgstr "免除重绑定保护"

msgid "Avoid dnsmasq filtering RFC1918 IP addresses (and some TESTNET addresses as well) from result."
msgstr "避免 dnsmasq 从结果中过滤 RFC1918 IP 地址（以及一些 TESTNET 地址）。"

