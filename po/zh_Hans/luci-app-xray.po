msgstr "暂无配置"

# ========== Extra Options 页面 ==========
msgid "Xray Executable Path"
msgstr "Xray 可执行文件路径"

msgid "/usr/bin/xray (default, exist)"
msgstr "/usr/bin/xray（默认，存在）"

msgid "日志级别"
msgstr "日志级别"

msgid "Read Xray log in \"System Log\" or use `logread` command."
msgstr "在“系统日志”中查看 Xray 日志，或使用 `logread` 命令。"

msgid "Enable Access Log"
msgstr "启用访问日志"

msgid "Access log will also be written to System Log."
msgstr "访问日志也将写入系统日志。"

msgid "Enable DNS Log"
msgstr "启用 DNS 日志"

msgid "DNS log will also be written to System Log."
msgstr "DNS 日志也将写入系统日志。"

msgid "Enable Xray API Service"
msgstr "启用 Xray API 服务"

msgid "Xray API Service uses port 8080 and GRPC protocol. Also callable via `xray api` or `Ubuntu call xray`. See here for help."
msgstr "Xray API 服务使用端口 8080 和 GRPC 协议。也可通过 `xray api` 或 `Ubuntu call xray` 调用。查看帮助请点击此处。"

msgid "Enable Statistics"
msgstr "启用统计"

msgid "Enable statistics of inbound / outbound data. Use Xray API to query values."
msgstr "启用入站/出站数据统计。使用 Xray API 查询数值。"

msgid "Enable Observatory"
msgstr "启用延迟观测"

msgid "Enable latency measurement for TCP and UDP outbounds."
msgstr "启用 TCP 和 UDP 出站的延迟测量。"

msgid "Enable Firewall Counters"
msgstr "启用防火墙计数器"

msgid "Add counters to firewall4 for transparent proxy rules. (Not supported in all OpenWrt versions.)"
msgstr "为透明代理规则添加 firewall4 计数器。（并非所有 OpenWrt 版本都支持。）"

msgid "Enable Xray Metrics Server"
msgstr "启用 Xray Metrics 服务器"

msgid "Enable built-in metrics server for pprof and expvar. See here for details."
msgstr "启用内置的 pprof 和 expvar 指标服务器。详情请点击此处。"

msgid "握手超时"
msgstr "握手超时"

msgid "Policy: Handshake timeout when connecting to upstream. See here for help."
msgstr "策略：连接上游时的握手超时时间。查看帮助请点击此处。"

msgid "Connection Idle Timeout"
msgstr "连接空闲超时"

msgid "Policy: Close connection if no data is transferred within given timeout. See here for help."
msgstr "策略：如果在指定超时时间内没有数据传输，则关闭连接。查看帮助请点击此处。"

msgid "Uplink Only Timeout"
msgstr "仅上行超时"

msgid "Policy: How long to wait before closing connection after server closed connection. See here for help."
msgstr "策略：服务器关闭连接后等待多久再关闭连接。查看帮助请点击此处。"

msgid "Downlink Only Timeout"
msgstr "仅下行超时"

msgid "Policy: How long to wait before closing connection after client closed connection. See here for help."
msgstr "策略：客户端关闭连接后等待多久再关闭连接。查看帮助请点击此处。"

msgid "缓冲区大小"
msgstr "缓冲区大小"

msgid "Policy: Internal cache size per connection. See here for help."
msgstr "策略：每个连接的内部缓存大小。查看帮助请点击此处。"

msgid "Show preview or deprecated features (requires reboot to take effect)."
msgstr "显示预览或已弃用的功能（需要重启才能生效）。"

msgid "Preview or Deprecated"
msgstr "预览或已弃用"

